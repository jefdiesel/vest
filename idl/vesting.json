{
  "version": "2",
  "name": "vesting",
  "docs": "Vest: RFP-017 token vesting on LEZ v0.4.0-rc3. Messages are root calls to the caller's own actor (X, V); state lives at the schedule actor (S, V), S = for_public_pda(V, SHA256('/RFP017/vesting/schedule/v1' || creator || nonce)).",
  "messages": [
    {
      "name": "Create",
      "tag": 0,
      "docs": "Creator: create and fund each schedule (native transfer, or token holding + transfer, plus an optional fee float). Sent to the caller's own actor (X, V); reads the clock.",
      "fields": [
        {
          "name": "schedules",
          "type": {
            "vec": {
              "defined": "NewSchedule"
            }
          }
        }
      ]
    },
    {
      "name": "Claim",
      "tag": 1,
      "docs": "Beneficiary: pay what vested by the clock (rounded down to `granularity` ms, at least 1) to `to`.",
      "fields": [
        {
          "name": "schedule",
          "type": "account_id"
        },
        {
          "name": "to",
          "type": "account_id"
        },
        {
          "name": "to_private",
          "type": "bool"
        },
        {
          "name": "granularity",
          "type": "u64"
        }
      ]
    },
    {
      "name": "ClaimAsOf",
      "tag": 2,
      "docs": "Beneficiary: pay what vested by `as_of`; the transaction is valid only in blocks with timestamp >= as_of. No clock read: a private claim's proof never expires.",
      "fields": [
        {
          "name": "schedule",
          "type": "account_id"
        },
        {
          "name": "to",
          "type": "account_id"
        },
        {
          "name": "to_private",
          "type": "bool"
        },
        {
          "name": "as_of",
          "type": "u64"
        }
      ]
    },
    {
      "name": "Cancel",
      "tag": 3,
      "docs": "Cancel authority: refund the unvested part to the creator; what vested stays claimable. Reads the clock at 1 ms.",
      "fields": [
        {
          "name": "schedule",
          "type": "account_id"
        }
      ]
    },
    {
      "name": "MakeIrrevocable",
      "tag": 4,
      "docs": "Cancel authority or creator: make a cancelable schedule irrevocable (one-way). Reads the clock.",
      "fields": [
        {
          "name": "schedule",
          "type": "account_id"
        }
      ]
    },
    {
      "name": "SignalMilestone",
      "tag": 5,
      "docs": "Milestone authority: unlock tranche `index`; a repeat is refused (code 18). Reads the clock.",
      "fields": [
        {
          "name": "schedule",
          "type": "account_id"
        },
        {
          "name": "index",
          "type": "u32"
        }
      ]
    },
    {
      "name": "TransferBeneficiary",
      "tag": 6,
      "docs": "Beneficiary of a transferable schedule: hand the position to `new_beneficiary`. Reads the clock.",
      "fields": [
        {
          "name": "schedule",
          "type": "account_id"
        },
        {
          "name": "new_beneficiary",
          "type": "account_id"
        }
      ]
    }
  ],
  "state": {
    "defined": "ScheduleState"
  },
  "events": [
    {
      "name": "Created",
      "selector": "ff55b26d55f2793a",
      "type": {
        "defined": "VestingEvent"
      }
    },
    {
      "name": "Claimed",
      "selector": "aa25b4641ce8cb29",
      "type": {
        "defined": "VestingEvent"
      }
    },
    {
