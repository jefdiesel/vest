// The Vesting app's backend interface. The C++ file in this directory is the MOCK; the real
// Logos core module implements these same slots by calling the SDK in ../../sdk/src/client.rs
// (one SDK call per slot), as documented in ../module/README.md.
//
// Every slot returns JSON text with at least {"ok": bool, "error": string when not ok}.
// Amounts are decimal strings; times are epoch milliseconds; ScheduleId (u64 in the SDK) is
// a qlonglong here. The caller (beneficiary account) is supplied by the module/wallet, not by
// the view, exactly as the SDK's claim/cancel/signal methods take a caller AccountId.

class VestingUi
{
    // Client::list() — all schedules visible to this wallet.
    SLOT(QString list())

    // Client::now() — the effective time (ms) the module uses, so the view shows what it returns.
    SLOT(QString now())

    // Client::pre_claim_summary(id, AccountKind) — claimable, estimated fee, next unlock.
    SLOT(QString preClaimSummary(qlonglong id, bool isPrivate))

    // Client::create(CreateParams).
    SLOT(QString create(QString params))

    // Client::create_batch(Vec<CreateParams>) — one call for the whole batch form.
    SLOT(QString createBatch(QString params))

    // Client::claim_public(id, caller).
    SLOT(QString claimPublic(qlonglong id))

    // Client::claim_private(id, caller, AccountRef) — the SDK rejects a non-private target.
    SLOT(QString claimPrivate(qlonglong id, QString target))

    // Client::cancel(id, caller).
    SLOT(QString cancel(qlonglong id))

    // Client::make_irrevocable(id, caller).
    SLOT(QString makeIrrevocable(qlonglong id))

    // Client::signal_milestone(id, caller, index).
    SLOT(QString signal(qlonglong id, int index))

    // Client::transfer_beneficiary(id, caller, newBeneficiary).
    SLOT(QString transfer(qlonglong id, QString newBeneficiary))

    // Module helpers, NOT SDK calls (until the SDK's names module lands on this branch):
    // names() -> {"ok":true,"names":{"alice":"<account>",...}} for showing names by address.
    SLOT(QString names())
    // resolveName(name) -> {"ok":true,"name":..,"account":..} or {"ok":false,"error":..}.
    SLOT(QString resolveName(QString name))
}
