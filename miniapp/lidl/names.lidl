module names {
  version "0.17.0"
  depends []

  method recipient(name: tstr) -> tstr description "Where to send a payment for `name` (`jef.lez` or `jef`). The value is\n`{name, display, public, public_hex, private}`: `private` is\n`{nullifier_public_key, viewing_public_key}` in hex or null, and\n`public` is an account ID or null. Prefer `private` when it is there.\nA name that forwards (its `forward` entry, SPEC.md §7) is paid where it\npoints, one hop: then `name` is the target and `forwarded_from` the name\nasked for, which a payer must be shown. A null value means the name is\nnot registered."
  method resolve(name: tstr) -> tstr description "Everything `name` resolves to: `{name, display, owner_tag, expires,\nnever, lapsed, deposit, account, npk, vpk, texts}`. A name held by a\ndeposit never expires: `expires` is null, `never` true and `lapsed`\nfalse; `deposit` is what its deposit account holds (decimal text), which\na release refunds. In fee mode `expires` is in milliseconds and `lapsed`\nis true once it has passed. `owner_tag` is the holder's tag (hex): the\nchain never names the holder. A null value means it is not registered,\nwhich includes a fee-mode name that lapsed more than 30 days ago.\n`forward` is the name it points to (SPEC.md §7, Forwarding), or null:\n`resolve` doesn't follow it, so the name's holder can still edit it."
  method page(name: tstr) -> tstr description "The page published under `name`: `{content_type, bytes, text}`, where\n`text` is the body if it is valid UTF-8. A null value means no page.\nThe page is written by the name's owner: treat it as untrusted content."
  method page_view(name: tstr) -> tstr description "The page published under `name`, made safe to show inside an app:\n`{content_type, bytes, kind, title, html, text, truncated}`. `kind` is\n`html`, `text` or `file`. For an HTML page, `html` is the body rewritten\nto an allowlist Qt's rich text can draw (headings, paragraphs, lists,\ntables, emphasis, code, and links to `http:`/`https:` URLs only; no\nscripts, styles, images, attributes or comments), and `title` is its\n`<title>` as plain text; both are null otherwise. `text` is the page's\nown source, as in `page`, to be shown only as plain text. At most 64 KB\nof a page is read; `truncated` says it was cut. A null value means no page."
  method page_preview(body: tstr) -> tstr description "`body`, a page not yet published, as `page_view` would show it: an\nHTML body (one that opens with a tag) sanitized the same way, anything\nelse as plain text. For previewing a page while it is written."
  method avatar(name: tstr) -> tstr description "The picture in `name`'s `avatar` entry, decoded, for an app that can't\nload a `data:` URL: `{width, height, pixels}`, where `pixels` is base64\nof RGBA8 bytes, row by row from the top left. At most 128 pixels a side\n(a larger picture is scaled down, nearest neighbour). Only PNG is\ndecoded. A null value means the name has no avatar this can decode."
  method reverse(account: tstr) -> tstr description "The name `account` (base58) has published for itself, or null. The\nanswer is checked against the name's own record, so it cannot be spoofed."
  method normalize(input: tstr) -> tstr description "The bare name for what a person typed (`Jef.LEZ` gives `jef`), or an\nempty string if it is not a valid name. Makes no network call."
  method wallet() -> tstr description "The open LEZ wallet: `{accounts: [{account, balance, funded, name}],\nprivate_accounts: [account]}`. `accounts` are its public accounts,\nfunded ones first; `balance` is decimal text and `name` is the name the\naccount has published, or null. Fails if the LEZ wallet is not\ninstalled or not open."
  method mine() -> tstr description "The names this device remembers that the open wallet holds, and the\nregistrations it has under way: `{names: [{name, display, owner,\nexpires, never, lapsed}], pending: [{name, display, owner, stage,\nready_at, tx}]}`. `owner` is the wallet's account that holds the name.\nA pending `stage` is `committed` (call `reveal_name` from `ready_at`, in\nmilliseconds; it never starts a new registration) or `revealed` (sent; it shows in `names`\nonce it lands). The chain keeps no list of names, so this is the\ndevice's own memory: every name registered from here, and every name\npassed to `keep`."
  method keep(name: tstr) -> tstr description "Remembers `name` on this device, if the open wallet holds it, so `mine`\nkeeps returning it. Fails for a name the wallet does not hold. The value is the bare name."
  method deposit(name: tstr) -> tstr description "What registering `name` takes: `{name, display, tier, deposit, mode,\nclaims_until}`.\n`tier` is `normal`, `three` (a three-character name, at the higher\ndeposit) or `locked` (one or two characters: only the registry's admin\nmay register it, and `deposit` is null). `deposit` is decimal text in\nthe native token's base units, held while the name is and refunded on\nrelease. `mode` is `deposit`, `fee` or `unconfigured`; in fee mode\n`deposit` is 0 and `fee` gives the price of a one-year term instead.\n`claims_until` is null, or while names from the earlier chain can still be\nclaimed, when that ends, in milliseconds of chain time: until then a holder's\nclaim replaces a registration of their name, and whoever registered it loses\nthe deposit to them. An app must say so first (SPEC.md section 8.4).\nMakes one network read, besides deriving the name."
  method settings() -> tstr description "The registry's settings: `{mode, deposits: {normal, three}, admin,\ntreasury, prices: {30d, 1y, 5y}, claims_until}`, amounts as decimal text,\n`claims_until` as in `deposit`. A null value\nmeans the registry has no settings yet (it charges nothing, and locks\none- and two-character names)."
  method register_name(name: tstr, owner: tstr, private_account: tstr) -> tstr description "Registers `name` to `owner` (base58), a public account in the open\nwallet, which pays the deposit (see `deposit`). Registering is two\nsteps, so that nobody watching pending transactions can take the name\nfirst: the first call sends a commitment, which hides the name, and\nanswers `stage: \"committed\"` with `ready_at` (milliseconds, chain time,\nabout 15 minutes on). Calling `register_name` again from then on sends the\nreveal that claims the name (`stage: \"revealed\"`), and once that has\nlanded, answers `stage: \"registered\"` without sending anything. A call\nbefore `ready_at` sends nothing. The commitment is kept on this device\nand stays usable for 24 hours. The value also has `deposit` (or `fee`)\nand `tier`; `tx` is null when nothing was sent.\n`private_account` makes the name payable privately from the start: one\nof the wallet's private accounts (base58), `auto` for a new private\naccount made for this name alone, or empty to set nothing. It is used by\nthe reveal; given at commit time it is remembered for it, and the account\n`auto` makes is remembered too, so a retried reveal reuses it."
  method reveal_name(name: tstr, owner: tstr, private_account: tstr) -> tstr description "`register_name`'s later steps only: reveals the commitment kept for `name` and `owner`\non the network in use, or answers its stage. It never sends a new commitment: with none\nkept here, or one that never landed, it refuses and sends nothing. The app's reveal driver\ncalls this, so a network switch can never start a registration (MF-2). Names app only."
  method receive_privately(name: tstr, private_account: tstr) -> tstr description "Makes `name` payable privately and only privately: publishes the\nreceiving keys of `private_account` (as for `register_name`; `auto` makes a\nnew private account each time) and removes any public account from the name."
  method set_account(name: tstr, account: tstr) -> tstr description "Points `name` at a public account (base58). Anyone who resolves the\nname then sees that account, its balance and its history."
  method set_private_keys(name: tstr, nullifier_public_key: tstr, viewing_public_key: tstr) -> tstr description "Publishes the keys for private payments to `name`, both in hex: a\n32-byte nullifier public key and a 1184-byte viewing public key."
  method clear_addresses(name: tstr) -> tstr description "Removes the public account and the private keys from `name`."
  method set_text(name: tstr, key: tstr, value: tstr) -> tstr description "Sets the text entry `key` on `name`; an empty value removes it."
  method set_profile(name: tstr, entries_json: tstr, replace: bool) -> tstr description "Writes many text entries on `name` in one transaction, as the CLI's\n`names profile` does. `entries_json` is a JSON object of key to value\n(text); an empty value (or null) removes that key. The card keys are\n`display`, `bio`, `avatar` (a `data:image/...` URL), `theme` (`light`,\n`dark` or `auto`), `color` (`#rrggbb`), `font` (`sans`, `serif`, `mono`\nor `rounded`) and `cid` (a Logos Storage content ID); any other key of\n1-32 characters of a-z, 0-9, `-`, `_` or `.` works too. With `replace`,\nevery existing entry is dropped first, so the object becomes the whole\nset; the name's account and payment keys stay either way. A name holds\nat most 16 entries and its sealed profile at most 12 KiB."
  method set_page(name: tstr, content_type: tstr, body: tstr) -> tstr description "Publishes `body` as the page of `name`; an empty body removes the page."
  method transfer(name: tstr, new_owner: tstr) -> tstr description "Hands `name` to `new_owner` (base58); only a tag of it reaches the\nchain. The addresses, entries and page the current owner set are\nemptied. The deposit stays with the name, for whoever releases it."
  method release(name: tstr) -> tstr description "Gives `name` up. Its record and page are emptied, anyone may register\nit again, and its deposit comes back to the holder: the value has\n`refund`, the deposit account's whole balance (decimal text)."
  method set_primary(account: tstr, name: tstr) -> tstr description "Publishes `name` as what `account` (base58, in the open wallet) is\nshown as; an empty name withdraws it. This is the one change that puts\na name on the chain in the clear."
  method get_config() -> tstr description "The sequencer URL, registry program ID and wallet files in use. To the Names app, the\nplain object (as every version of the app reads it); to any other app, the network part\nonly (`sequencer`, `names_sequencer`, `registry`, `token_program`, `zone`,\n`names_network`, `module_version`) in the usual `{success, value, error}` envelope\n(since 0.17.0; before, it was a plain object for every caller)."
  method set_names_network(network: tstr) -> tstr description "Switches the names network to `network`: `lez-0.3` (the public Logos testnet) or\n`lez-0.4` (our bridge test network, the default since wallet-1121). Names are then looked\nup, registered and paid there, with that network's own CLI, wallet folder, registry and\nsequencer; the other network's settings are kept as they are. `lez-0.4` is always our own\nLEZ 0.4: a custom network in use (`network_custom`) is left for it (its RPC, registry and\nbridges go back to the built-in ones; the CLI and wallet folder stay) and kept as\n`custom_network_last`. Refused while the wallet is busy. The value is `get_config`'s.\nNames app only."
  method network_custom(rpc: tstr, chain_id: tstr, file_url: tstr, apply: bool) -> tstr description "A LEZ 0.4 network entered by hand (Settings, Network, Custom network; docs/wallet/NETWORKS.md):\nthe RPC at `rpc` must say it serves the chain `chain_id` (64 hex, `getChannelId`), or\nnothing is done (\"That RPC serves chain …, not …\"). The registry, bridges, NFT programs and\nfaucet come from the network file at `file_url` (empty: `https://nameswallet.app/networks/<chain-id>.json`),\nwhich must name the same chain; for our own LEZ 0.4's chain a missing file (404) keeps the\nbuilt-in ids. With `apply` false nothing changes: the value is what was found,\n`{chain_id, rpc, height, file_url, file, file_missing, builtin, in_use, differs, reset}`,\nwhere `reset` is `{before, now}` when this chain's height went down since it was last read\n(a reset that kept the chain id: reads made before are dropped, and the reset is told as a\nbalance read tells one). With `apply` true the checks are made again, then the wallet is on\nthat network (LEZ 0.4, its RPC, the file's ids, its NFT programs added), and the value is\n`get_config`'s with `network_set` (what was found). Refused while the wallet is busy.\nNames app only."
  method deed_tiers(names_json: tstr) -> tstr description "Whether each of `names_json` (a JSON list of names) can have a deed: `{<name>: true |\nfalse | null}`. True for the normal tier (5 to 32 characters, not locked or reserved),\nfalse for the others, null while it is still being read (on a thread of its own, from the\nnames CLI's list; asked again, it answers). A name's deed itself is in `resolve` (`deed`).\nNames app only."
  method deed_claim(name: tstr) -> tstr description "Claims the deed of `name`, held by this wallet: free (gas only), optional, once while it is\nheld; a CLI job (`names deed claim`), followed with `job` like a transfer. Refused on LEZ\n0.3 (deeds are on LEZ 0.4) and for a name that already has one. Names app only."
  method set_bridge_program(program_id: tstr) -> bool description "Sets the one bridge program the Wallet reads on LEZ 0.4 (its Config lists the bridged\ntokens): a program ID, or empty for the built-in default. It replaces the whole list\n(`set_bridge_programs`). Kept in config.json under `lez04.bridge_programs` (and\n`lez04.bridge_program`, the first, for earlier 0.17 builds), whichever network is in use;\na redeployed bridge needs this, not a new build. False, and nothing changed, for\nanything that isn't a program ID. Names app only."
  method set_bridge_programs(programs_json: tstr) -> bool description "Sets every bridge the Wallet knows on LEZ 0.4: a JSON array of 0 to 4 program IDs\n(`[]` for the built-in default). Adding or removing a bridge is sending the new list.\nEach bridge's tokens are shown, and each bridge's token program is refused as the root\nof a relayed call. False, and nothing changed, for a list that isn't 0-4 distinct\nprogram IDs (the native token is not one). Names app only."
  method set_registry(program_id: tstr) -> bool description "Use the registry with this program account ID (base58), and remember it\nacross restarts. Returns false and changes nothing if it is not an\naccount ID."
  method set_sequencer(url: tstr) -> bool description "Has the zone in use read from the sequencer at this URL, and remembers\nit across restarts (`zone_sequencer` for that zone, without\n`other_chain_ok`). Returns false and changes nothing unless it is an\nhttps URL (http on this computer) of a sequencer that serves the same\nchain; one that serves another chain is another zone (`zone_add`)."
  method zone_list() -> tstr description "The zones set up here: `{zones: [{id, name, channel, sequencer, home,\ncurrent, wallet_dir, has_wallet, token_program}], current, max}`. A\nzone's `id` is `home`, or its channel."
  method zone_add(name: tstr, sequencer: tstr) -> tstr description "Adds the zone the sequencer at `sequencer` serves, called `name` (empty:\n\"Zone\" and the start of its channel). Refused when the sequencer doesn't\nsay its channel, or serves a zone already here. Replies as `zone_list`,\nwith `added`, the new zone's id; it isn't in use until `zone_use`."
  method zone_use(zone: tstr) -> tstr description "Uses zone `zone` (an id from `zone_list`) from now on, and remembers it\nacross restarts. Refused while a wallet job runs. Replies as `zone_list`."
  method zone_remove(zone: tstr) -> tstr description "Forgets zone `zone`: not home, and not the one in use. Its wallet folder\nstays on disk. Replies as `zone_list`, with `removed`: `{name, channel,\nwallet_dir}`."
  method zone_rename(zone: tstr, name: tstr) -> tstr description "Calls zone `zone` `name` from now on. Replies as `zone_list`."
  method zone_sequencer(zone: tstr, url: tstr, other_chain_ok: bool) -> tstr description "Has zone `zone` use the sequencer at `url`. The zone's wallet, accounts\nand history stay as they are, so the sequencer must name the zone's own\nchannel; one that names another chain, or doesn't say, is refused and\nnothing changes. Replies as `zone_list`, with `changed: true` and\n`channel`. For home and another chain the reply is `{changed: false,\nother_chain: true, channel, why}`, and asking again with\n`other_chain_ok` makes that chain home."
  method set_wallet_files(config_path: tstr, storage_path: tstr) -> bool description "Names the wallet to open when the LEZ wallet module is running with no\nwallet open: the paths of its configuration and storage files, as the\nLEZ Wallet app writes them. Remembered across restarts; two empty paths\nforget it. Returns false and changes nothing if a file does not exist."
  method cli_claim(name: tstr, snapshot: tstr) -> tstr description "Takes back `name`, held on the earlier chain by an account of the CLI's wallet,\nfor free, with its profile and page as they were: starts `names claim` as a job.\n`snapshot` is the snapshot the registry's claims list was made from: a file's full\npath, an `http` or `https` URL, or empty for the one published with the web app.\nUntil `claims_until` this replaces a registration of the name. Only a name held by\na public account can be claimed: LEZ 0.4 derives other private account IDs."
  method cli_restore_wallet(phrase: tstr) -> tstr description "Brings back a wallet from before LEZ 0.4, which no longer opens, from its recovery\nphrase. `cli_status` says when one is needed (`old_wallet`). The old wallet's files\nstay beside the new ones. The value is `{public: [account], private, moved: [path]}`:\nthe first public accounts the phrase derives, since a new chain shows none of them\nas used, and a new private account. Tokens are not carried over."
  method backup_status() -> tstr description "Settings → Backup: `{last: {at, networks, file} | null, networks: [{id, shown, folder,\nhas_wallet, reachable, accounts, uncovered}], folder}`; `uncovered` counts the accounts no\nrecovery phrase brings back (imported ones). Reads no key out. Names app only."
  method backup_make(networks: tstr, password: tstr, path: tstr) -> tstr description "Makes ONE encrypted backup file of the wallet folders of `networks` (`lez-0.3`, `lez-0.4`,\ncomma-separated) under `password` (at least 10 characters): Argon2id (64 MiB, 3 passes)\nand AES-256-GCM, mode 600, at `path` (a `.lnsbackup` file; \"\" = `~/Documents/Names Wallet\nBackups/` with a dated name), never over a file that is there. Then opens it again and\ncompares it with the wallets: `{file, networks, accounts, check}`. Names app only."
  method backup_check(path: tstr, password: tstr) -> tstr description "Opens backup `path` with `password` in memory and compares it with the wallets here:\n`{opens, created, networks: [{id, accounts, matches, differs}]}`. Writes nothing. Names app only."
  method backup_open(path: tstr, password: tstr) -> tstr description "What backup `path` holds (opened in memory with `password`) and where each network would\ngo: `{created, networks: [{id, shown, accounts, folder, has_wallet, can_restore}]}`. Writes\nnothing. Names app only."
  method backup_restore(path: tstr, password: tstr, network: tstr) -> tstr description "Restores `network` from backup `path` into this computer's wallet folder for it, only\nwhen that folder holds no wallet (never over one): `{network, folder, files, accounts}`.\nNames app only."
  method cli_mine() -> tstr description "The names the CLI's wallet holds, as `names mine` lists them: `[{name,\ndisplay, signer, state, lapsed}]`, `signer` being `cli`. A wallet\ndirectory with no wallet in it holds none (and the CLI is not run, so\nit makes none). Waits for the CLI, at most 15 seconds."
  method cli_add_name(name: tstr) -> tstr description "Lists `name` among the names the CLI's wallet holds, as a job: `names mine --add`, which\nchecks on chain that this wallet holds it first (one it doesn't hold is refused, nothing\nadded). For a name held but not listed: one handed to this wallet, or registered here\nbefore 0.17 listed public registrations. Names app only."
  method cli_profile(name: tstr, entries_json: tstr, replace: bool) -> tstr description "Starts `names profile` for `name`: `entries_json` is a JSON object of\nkey to text, as for `set_profile`. `display`, `bio`, `theme`, `color`,\n`font` and `cid` go to their own options, any other key to `--set`, and\nan empty value (or null) removes the key. `avatar` is passed only when\nit is the full path of a PNG file on this machine; any other avatar\nvalue is left as it is (with `replace`, a `data:image/` URL is kept),\nand the answer's `skipped` lists it."
  method cli_set_page(name: tstr, content_type: tstr, body: tstr) -> tstr description "Starts `names set-page` with `body` (written to a file in the jobs\ndirectory, removed once the job ends); an empty body starts `names\nclear-page`."
  method cli_set_text(name: tstr, key: tstr, value: tstr) -> tstr description "Starts `names set-text`; an empty value removes the entry."
  method cli_transfer(name: tstr, new_owner: tstr) -> tstr description "Hands a name the names CLI holds to `new_owner` (`Public/…` or `Private/…` and its\nID), as a job: `names transfer`. Its receiving keys, text entries and page\nare cleared; the new holder runs `receive-privately`. It can't be undone."
  method cli_receive_privately(name: tstr) -> tstr description "Sets up payments to a name the wallet holds (one handed to it), as a job:\n`names receive-privately`."
  method cli_register(name: tstr, as_public: bool) -> tstr description "Registers `name` through the names CLI, from its private account, so\nthe holder never appears on chain. Starts a job like `cli_set_text`;\nit ends once the commitment is made (a proof of a few minutes), and\nthe CLI finishes the registration in the background about 15 minutes\nlater. `cli_mine` lists it with `registering` true until then. With\n`public`, the CLI then moves it to a new public account funded privately\n(`names make-public`), so it posts in one block and nothing links it to you."
  method board_feed(following: bool) -> tstr description "The board's recent posts, newest first, read through the names CLI:\n`{posts, updating, error}`, where `posts` is `[{post, name, n, parent,\ntime, text, cids, likes, hidden, block}]` (`post` and `parent` written\n`<name>/<n>`). Reading takes the CLI many seconds, so this answers at once\nwith the last result and fetches a newer one on its own thread; while\n`updating` is true, ask again shortly. With `following` true, only posts\nby the names this device follows."
  method board_posts_of(name: tstr, before: int) -> tstr description "Ten posts by `name`, newest first, below post number `before` (its newest\nwhen negative), read straight from the board: answered as `board_feed`\nis, with `posts` holding `{total, posts}`."
  method board_thread(post: tstr) -> tstr description "A post (`<name>/<n>`) and its replies, oldest first, answered as `board_feed` is."
  method board_post(name: tstr, text: tstr, cids_json: tstr, reply: tstr) -> tstr description "Posts `text` as `name`, which the CLI's wallet holds privately, with up to\nfour Logos Storage CIDs (`cids_json`, a JSON list) and, if `reply` is a\npost, as a reply to it. A CLI job, as `cli_set_text`; about 4 minutes."
  method board_like(name: tstr, post: tstr, undo: bool) -> tstr description "Likes `post` as `name` (or takes the like back with `undo`). A CLI job."
  method board_hide(post: tstr) -> tstr description "Takes down `post`, one of the CLI wallet's names' posts. A CLI job."
  method board_follows() -> tstr description "The names this device follows, a JSON list."
  method board_follow(name: tstr, undo: bool) -> tstr description "Follows `name` (or stops, with `undo`); kept on this device only."
  method main_name() -> tstr description "The name this device posts, likes and pays as, or null if none is set."
  method set_main_name(name: tstr) -> tstr description "Sets the name this device posts, likes and pays as."
  method anon_name() -> tstr description "The names CLI wallet's anonymous name (`names anon`), or null if it has none yet."
  method make_anon(as_public: bool) -> tstr description "Makes the wallet's anonymous name, a CLI job (`names anon`): a private\ntransfer of a few minutes, then a registration of about 20 that the CLI\nfinishes in the background."
  method running_jobs() -> tstr description "The CLI jobs still running, `[{id, name, kind, state, started}]`, so an app\nopened mid-change can show it and wait for it."
  method make_public(name: tstr) -> tstr description "Moves `name` from the CLI wallet's private account to a new public account\nin it (`names make-public`), so its posts take one block and pay gas. A CLI\njob of about 9 minutes; the name keeps its profile, page and receiving keys."
  method board_likes() -> tstr description "The posts this device's names have liked, `<name>/<n>`."
  method dm_names() -> tstr description "Which name each chat conversation is with: `{convo_id: name}`."
  method set_dm_name(convo_id: tstr, name: tstr) -> tstr description "Remembers that chat conversation `convo_id` is with `name`; an empty\nname forgets it."
  method chat_names() -> tstr description "Which name each chat address belongs to: `{address: name}`."
  method set_chat_name(address: tstr, name: tstr) -> tstr description "Remembers that chat address `address` is `name`'s."
  method spell_check(text: tstr) -> tstr description "The words in `text` that look misspelled, `[{word, suggestions}]`, checked\non this machine against the system's word list. Names, links and CIDs are skipped."
  method board_toggle_like(name: tstr, post: tstr) -> tstr description "Likes `post` as `name`, or takes the like back if this device liked it.\nA CLI job; the like is remembered here once it is started."
  method cli_pay(name: tstr, amount: tstr) -> tstr description "Pays `amount` (base units, decimal text) to `name` from the CLI wallet's\nprivate account, privately (`names pay`). A CLI job; about 4 minutes."
  method cli_pay_public(name: tstr, amount: tstr) -> tstr description "Pays `amount` to `name`'s public account from the CLI wallet's default public\naccount (`names pay --public --from=Public/…`): no proof, about one block, and the\nchain shows both accounts and the amount. A name that publishes no public account\ncan't be paid this way (the CLI refuses). A CLI job."
  method cli_balance() -> tstr description "The names CLI's default private account and its balance:\n`{account, balance, public}` (decimal text), or null if it has none.\n`public` is its default public account the same way, `{account,\nbalance}`, or null: that is the account `cli_bridge` credits. Runs\n`names balance`, which first catches up with the chain (seconds to a\nminute), so ask with a long timeout."
  method cli_bridge(amount: tstr, from_key: tstr, node: tstr, send: bool) -> tstr description "Bridges `amount` (base units, decimal digits) from the notes of the\nLogos Blockchain public key `from_key` (64 hex characters) into LEZ,\ncredited to the names CLI wallet's default public account, through the\nperson's own Logos Blockchain node at `node` (`http(s)://127.0.0.1:<port>`\nor `localhost:<port>`; empty is Basecamp's, `http://127.0.0.1:8080`).\nRuns `names bridge` and waits for it (no proving; at most two minutes).\nWithout `send` it only shows the plan and moves nothing; with `send`\nthe deposit is made and cannot be undone. LEZ credits it once the Logos\nBlockchain block holding it is final, about 12 hours on the testnet.\nThe value is `{sent, lines, hash, total, notes, fee, to}`: `lines` are\nwhat the CLI printed, `total` what the whole notes picked add up to\n(a little more than `amount`, at most 30 notes), `hash` the deposit's\n(null for a plan). The key and node are remembered (`get_config`'s\n`bridge_key` and `bridge_node`). Every argument is checked first."
  method cli_bridge_to(amount: tstr, from_key: tstr, to: tstr, node: tstr, send: bool) -> tstr description "`cli_bridge`, credited to the LEZ public account `to` (`Public/<id>`, one the\nperson picked; empty is the wallet's default public account)."
  method cli_faucet() -> tstr description "Asks the Names faucet to pay the wallet's default public account a\nlittle LEZ (2,000,000 on the testnet: a name's 1,000,000 deposit and as\nmuch to use), once a day per account and per internet address. `{account, amount, tx}` once the faucet has sent\nit; it arrives within a minute or two (`cli_balance` shows it). The\nfaucet's own refusal (funded today, empty, busy) comes back as the error."
  method cli_status() -> tstr description "Where the names CLI stands, read without running it: `{cli, prover,\ninstalling, wallet_dir, wallet, public, private, busy}`. `cli` is the\nprogram the module would run (null if none is found), `prover` whether\nRISC Zero's prover is beside it, `installing` the running `cli_install`\njob or null, `wallet` whether its wallet folder holds a wallet,\n`public` and `private` the accounts `names setup` made (null until\nthen), and `busy` the running wallet job (`cli_shield` or\n`cli_pay_account`) or null. Answers at once."
  method cli_install() -> tstr description "Installs the names CLI and RISC Zero's prover into the module's own\nfolder (`~/.config/logos-names/bin`, man pages in `.../man`), by running\nthe official installer built into the module: it checks every file's\nsignature against the release key and its SHA-256, and changes nothing\nelse (not the shell's startup files). A CLI that already works is left\nalone. The value is `{installed, path, version, prover, job}`: with\n`installed` true there is nothing to do; otherwise `job` is the install\njob (`{id, name, kind: \"install\", state, started}`, seconds to a minute, most\nof it the 70 MB prover). `job` on it says how it goes; once it is\n`done`, its state carries `version` and `path` and the module uses that\nCLI from then on (saved as `cli`, with `cli_wallet` the CLI's default\nwallet folder if none was set). A failed one carries `problem`, in plain\nwords (no internet, signature check failed, unsupported computer), and a\ndone one whose prover didn't download carries `warning`."
  method cli_install_bundled(path: tstr, sha256: tstr) -> tstr description "On LEZ 0.4 with no names tool set: installs the tool the Names app ships (`path`, a file\nnamed `names-lez04` in its package) into the module's folder (`bin/names-lez04`), when its\nSHA-256 is `sha256` and it says it is a LEZ 0.4 tool, and uses it from then on. A tool\nalready set (that exists) is left as it is: `{installed: false, kept: <path>}`. Otherwise\n`{installed: true, path, version}`. Names app only. get_config `features`: `bundled_tool`."
  method cli_create_wallet() -> tstr description "Makes the names CLI's wallet, with a public and a private account, if\nit has none: `names setup` moving nothing, so it never proves. Waits\nfor it, a few seconds (at most three minutes if an old wallet catches\nup with the chain). The value is `{public, private, phrase}`: `phrase`\nis the new wallet's recovery phrase, the only way to get the wallet\nback, shown here once and never logged; it is null if the wallet already\nexisted. If the CLI failed after making the wallet, the value also has\n`problem`, so the phrase isn't lost."
  method cli_shield(amount: tstr) -> tstr description "Moves `amount` (empty: 5,000,000, enough for a few names' deposits)\nfrom the wallet's public account to its private one, so names can be\nheld and paid privately: `names setup` as a job that proves for a few\nminutes. Once it ends, its `job` state has `moved` and `problem`: the\nCLI moves nothing, and says so, when the public account holds too little."
  method cli_pay_account(account: tstr, amount: tstr, from_private: bool) -> tstr description "Pays `amount` to the public account `account`, written `Public/<id>`\n(a name is paid with `cli_pay`), as a job: `names wallet auth-transfer\nsend`. From the wallet's private account with `from_private` (a proof\nof a few minutes; the chain shows the account paid and the amount, not\nthe payer) or else its public one (one block; the chain shows the payer\ntoo)."
  method cli_receive() -> tstr description "Claims the payments waiting for the wallet's private accounts (what `cli_balance`'s\n`waiting` counts), as a wallet job: `names receive`. Each claim is a private\ntransaction, several minutes of proving, its fee paid by the wallet's private\naccount holding the most."
  method cli_receive_all() -> tstr description "`cli_receive` that claims every credit, also those worth less than claiming them\ncosts (`cli_balance`'s `small`: a private fee's refund, most often), as a wallet\njob: `names receive --all`. Each claim's fee is more than it brings in."
  method bridge_net_balances(accounts: tstr) -> tstr description "What the wallet's public accounts hold on the bridge test network (LEZ 0.4, the\nRFP-022 bridge's own chain, `bridge_net::RPC`), read only, beside the public Logos\ntestnet (LEZ 0.3) every other method uses. `accounts` is a JSON list of `Public/<id>`\n(24 are read at most, the rest counted in `not_read`; `Private/…` ones are counted in\n`private_accounts` and not read: that needs\nLEZ 0.4 viewing keys). Answers at once with the last read, `{network, version, rpc, read,\nupdating, error, private_accounts, watched, not_read}`, and reads again on its own thread when the last read\nis 30 s old. `read` is null until the first read ends, else `{channel, height, read_at,\nbridge, tokens: [{definition, symbol, decimals, name}], token_problem, reset_at,\naccounts: [{account, found, native, tokens: [{definition, symbol, decimals, amount}],\nother_tokens}]}`, amounts in base units as decimal text; `found` false is an account\nthat network has never seen (nothing there). `error` with a `read` is a failed newer\nread: `read` is then as of its `read_at`. `reset_at` (seconds) is when the network was\nseen restarted from a new genesis, told for a day. Money seen arriving there goes in\nthe History as `arrived` entries with `chain` `lez-0.4`. Nothing is sent. Names app only."
  method bridge_net_watch(account: tstr, watch: bool) -> tstr description "Adds (`watch`) or removes a public account (`Public/<id>` or a bare ID, 32 bytes in\nbase58) from the accounts `bridge_net_balances` also reads, besides the ones it is given:\nany public account, the wallet's or not (at most 8). Gives the list, `[\"Public/<id>\"]`.\nAn account the network has never seen reads as `found` false. Watched rows carry\n`watched` and never go to the History. Kept on this device. Names app only."
  method activity(account: tstr) -> tstr description "The Wallet's history, newest first: what this app sent on either chain (followed\nuntil it settles: `sending`, `in_block`, `arrived` for a bridge credited on LEZ,\n`done`/`failed` for a LEZ job) and money seen arriving (`arrived`: a balance that\nrose between two reads). With `account` (a LEZ account, a node key or a name),\nonly what involves it. Kept on this computer; neither chain is asked for history."
  method job(id: tstr) -> tstr description "How job `id` is going: `{id, name, kind, state, started, finished,\nexit, log_tail}`. `state` is `running`, `done` (the CLI exited 0: the\nchange was sent and included; `resolve` shows it) or `failed`;\n`log_tail` is the end of the CLI's output, whose last line says why it\nfailed. Times are in milliseconds. `fee` is what the changes it sent\ncost, `{about, at_most, paid}` (decimal text; `paid` null until one\napplied, or if it couldn't be measured), or null if it sent none that\nthe CLI prices (a payment to a bare account does not)."
  method set_cli(path: tstr) -> bool description "Runs the `names` CLI at this path, and remembers it across restarts;\nan empty path goes back to the default (`~/.local/bin/names`, then the\nfirst `names` on PATH). Returns false and changes nothing if it is not\nan executable file."
  method set_cli_wallet(dir: tstr) -> bool description "Has the CLI use the wallet in this directory (`LEE_WALLET_HOME_DIR`),\nand remembers it across restarts; an empty path goes back to the\ndefault, `~/.lee/wallet`. Returns false and changes nothing if it is\nnot a directory."
  method set_token_program(program_id: tstr) -> bool description "Has every token method use the token program `program_id` (base58),\nand remembers it across restarts (`get_config`'s `token_program`); an\nempty ID forgets it. Returns false and changes nothing if it is not an\naccount ID, or is the native token."
  method cli_token_holdings(account: tstr) -> tstr description "What the names CLI's accounts hold of each token, public and private:\n`{token_program, holdings: [{account, account_kind, definition, name,\nbalance}], updating, error}`, only `account`'s (written `Public/<id>`\nor `Private/<id>`) unless it is empty. `name` is the definition's own\nname (the token maker's text, cleaned) or null; amounts are decimal\ntext in base units. Read in the background (a private account's\nholdings need the wallet to catch up with the chain, up to a minute or\ntwo): the answer comes at once with the last read, null until the\nfirst ends, and `updating` while a newer one is on the way."
  method cli_token_pending() -> tstr description "The token credits sent to the wallet's private keys and not yet\nreceived: `{token_program, pending: [{position, definition, name,\namount, to}], updating, error}`, `to` the private account they credit.\nFrom the same read as `cli_token_holdings`. `cli_token_receive` takes them."
  method cli_token_info(definition: tstr) -> tstr description "What the token `definition` (its definition's account ID) is:\n`{definition, name, supply, authority}`; `authority` may mint more,\nnull for a fixed supply. Read from the chain through the CLI (seconds),\nthen kept for 30 seconds."
  method watched_tokens() -> tstr description "The tokens added to the wallet by address, for the token program in\nuse: `[{definition, name}]`, in the order added; `name` is the\ndefinition's own (as `cli_token_info` read it when added) or null."
  method watch_token(definition: tstr, watch: bool) -> tstr description "Adds (`watch`) or removes the token `definition` (its definition's\naccount ID) from the wallet's list, so it shows before any of it is\nheld. Adding reads the definition through the CLI first, so an ID that\nisn't a token of the program in use is refused. Gives the list as\n`watched_tokens` does. Kept on this device, per token program."
  method cli_token_send(definition: tstr, amount: tstr, to: tstr, from_private: bool, to_public: bool) -> tstr description "Sends `amount` (base units, decimal text up to 2^128 - 1) of the token\n`definition` (its definition's account ID) to `to`: a name, a public\naccount written `Public/<id>`, or one of the wallet's own\n`Private/<id>`. From the wallet's main private account with\n`from_private`, else its main public one. To a name it goes to the\nname's private receiving keys, where it waits until its holder receives\nit, unless `to_public` (or the name has only a public account). A\nwallet job (`names token send`): one block from the public account to\na public account; otherwise proven on this computer, 7-12 minutes.\nOnce it ends, its `job` state has `tx`, `block` and, if it failed,\n`problem`. Everything is checked before the CLI runs."
  method cli_token_receive() -> tstr description "Receives every token credit waiting for the wallet's private keys\n(`names token receive`), as a wallet job: one proven transaction per\ncredit, 7-12 minutes each, paid from a private account's LEZ. A job\nstops after 45 minutes; credits it didn't reach stay pending and the\nnext receive takes them. Its ended `job` state has `applied` (how many\nwere received), `nothing` (there was nothing to receive) and `problem`."
  method cli_accounts() -> tstr description "Every account of the names CLI's wallet: `[{account, kind, label,\nbalance, default, public_key, npk}]`. `account` is written `Public/<id>` or\n`Private/<id>`; `label` the nickname given here, or null; `balance`\ndecimal text (a public account's read from the chain, a private one's as\nthe wallet last saw it), or null if it couldn't be read; `default` marks\nthe account of its kind the wallet pays and registers from. `public_key`\n(hex, public accounts only) is what someone needs to pay a public\naccount the chain hasn't seen yet; `npk` (hex, private accounts only)\nis the key a name's profile publishes to be paid there, so it tells\nwhich name an account receives for. The wallet catches up with the chain\nfirst: seconds to a minute or two, so ask with a long timeout."
  method cli_account_new(kind: tstr, label: tstr) -> tstr description "Makes a new `kind` (`public` or `private`) account in the wallet, with\nthe nickname `label` (empty for none, at most 40 characters), and gives\nit as a `cli_accounts` entry. Nothing is sent and nothing is paid. A\nwallet without a default account of that kind makes it the default.\nRefused while a CLI job runs, since a job saves the wallet when it ends."
  method cli_account_import(text: tstr, label: tstr) -> tstr description "Imports ONE public account into the wallet in use from `text`: its signing key (64 hex\ndigits) or its key-chain JSON (`{\"Public\": …}`, `{\"ImportedPublic\": …}`, `{private_key,\naccount?}`), with an optional nickname. The names tool reads the key on standard input\n(`names module account-import`), never on a command line; nothing of `text` is ever in a\nreply, an error, a log or the history. Overwritten after use, best effort: the pasted text, a\nfile's text, the key taken out, the request line and the tool's stdin copy; NOT the JSON\nparser's temporaries or the host's and the app's own copies (account_import.rs).\n`{account, imported: true, notice, label}`. The recovery phrase does not cover the account.\nA private account's key chain is refused. Names app only. get_config `features` lists\n`account_import` (`account_import.rs`)."
  method cli_account_label(account: tstr, label: tstr) -> tstr description "Gives the wallet's `account` (`Public/<id>` or `Private/<id>`) the\nnickname `label`; an empty one clears it. `{account, label}`."
  method cli_account_use(account: tstr) -> tstr description "Pays and registers from `account` (`Public/<id>` or `Private/<id>`)\nfrom now on: it becomes the default of its kind, and `cli_balance`,\n`cli_pay`, `cli_register` and the rest use it. Names already held stay\nwith the accounts holding them; payments to a name go where the name\npoints, as before. Apps keep the accounts they were granted. Gives the\naccount as a `cli_accounts` entry. Refused while a CLI job runs."
  method cli_fee() -> tstr description "The chain's fees now: `{height, base_fee_exec, base_fee_stor,\npublic_transfer: {about, at_most}, private_transfer: {about,\nat_most}}`, amounts in base units as decimal text. `about` is what a\ntransfer costs at the current base fees, `at_most` what is held for it\n(a public transfer) or reserved in its proof (a private one) should\nfees climb before it lands. A job's state has `fee` for what it sent:\n`{about, at_most, paid}`, `paid` measured once it applied."
  method chain_status() -> tstr description "The node: `{height, slot, lib_slot, mode, epoch}`; `lib_slot` is the\nlast final block's slot, `mode` the node's (`Online` once synced)."
  method chain_accounts() -> tstr description "The keys the node's wallet holds: `[{key, balance, label?, title?,\nready?}]`, `balance` decimal text or null if it couldn't be read.\n`label` is the one given with `chain_account_label`/`_new`; an account\nmade with `chain_account_new` also has its keystore `title` and `ready`\n(false, balance null, until the node uses it from its next start). A\nhidden account (`chain_account_remove`) is left out while the node shows\nit holding nothing."
  method chain_stake() -> tstr description "Stake: `{staked, notes, keys, epoch, next_epoch_in_s, claimable,\nvouchers, reward_per_voucher}`, amounts as decimal text. `staked` is\nwhat the node's notes put in the leader lottery (any note on its keys,\nonce in an epoch's snapshot); `next_epoch_in_s` is null when the node\ndoesn't say. To unstake, send to a key the node doesn't hold."
  method chain_recipient(to: tstr) -> tstr description "Where `to` sends: `{key, name, forwarded_from}`. A key (64 hex) is\nitself; a name is the key its `blockchain` entry publishes, following\na `forward` one hop (`forwarded_from` is then the name asked for)."
  method chain_send(from_key: tstr, to: tstr, amount: tstr, send: bool) -> tstr description "Sends `amount` (base units: digits, commas only between groups of\nthree, so `1,000` but never `1,5`) from the node's key\n`from_key` to `to` (a key, or a name as `chain_recipient` reads it).\nWithout `send` it checks everything and gives the plan `{from, to,\nname, forwarded_from, amount, balance}`; with `send` the transfer is\nmade (it cannot be undone) and `hash` and `fee` (what it paid, decimal\ntext, or null if it couldn't be read) are added. The node proves it,\nwhich can take a minute, so ask with a long timeout. Keys the node lists\nbut its wallet doesn't hold are left out of `chain_accounts`."
  method chain_tx(hash: tstr) -> tstr description "Whether transaction `hash`, sent with `chain_send` on this device (kept\nacross restarts), is in a block: `{hash, state, fee}`. `state` is\n`pending` until its input notes leave the sender's wallet, then\n`in_block`. A hash not sent from here fails, saying why."
  method chain_claim(send: bool) -> tstr description "The node's leader rewards: without `send`, `{claimable, vouchers,\nreward_per_voucher}`. With `send`, one transaction claims ONE voucher\n(the node's `leader_claim` makes a single claim op) and pays its own\nfee from the node's leader funding key, which can be more than the\nreward: `{hash, claimed, fee, vouchers_left, claimable_left}`, with\n`warning` when the fee was more than `claimed`. Fails when there is\nnothing to claim."
  method chain_split(from_key: tstr, amount: tstr, send: bool) -> tstr description "Splits `amount` off the node key `from_key` into a note of its own, so a\nbridge can deposit exactly that much: a send from the key to itself (its\nchange comes back as another note). Without `send` the plan `{from, amount,\nbalance, exact}`, `exact` true when a note of exactly `amount` is already\nthere (no split needed); with `send` the transfer is made and `hash` and\n`fee` are added, followed by `chain_tx` like a send. The notes it spends\nleave the stake, and the new ones join it within two epochs."
  method chain_bridge(from_key: tstr, to: tstr, amount: tstr, send: bool) -> tstr description "Bridges exactly `amount` from the node key `from_key` into the LEZ public\naccount `to` (`Public/<id>`; empty is the names wallet's default public\none): one note of exactly that value is deposited on LEZ's channel through\nBasecamp's node (`channel_deposit_with_notes`), its fee paid from the key's\nother notes, at most `fee`. Without `send` the plan `{sent: false, hash:\nnull, to, amount, total, notes, fee, note, needs_split, channel, lines}`;\n`needs_split` is true (and `note` null) when no note holds exactly\n`amount`: `chain_split` first. With `send` the deposit is made (it cannot be\nundone) and `sent`, `hash` are set; `chain_tx` follows it. LEZ credits it\nonce the block holding it is final."
  method chain_account_new(label: tstr) -> tstr description "Makes a new account on the node: a key in its keystore, labelled\n`label` (at most 40 characters; empty for none): `{key, title, label,\nready, note}`. The node uses it from its next start (`ready` false\nuntil then; `note` says so). Its secret stays in the node's keystore."
  method chain_account_label(key: tstr, label: tstr) -> tstr description "Labels the node key `key` (empty takes the label off): `{key, label}`.\nLabels are kept by this module, and shown by `chain_accounts`."
  method chain_account_remove(key: tstr) -> tstr description "Hides an account made with `chain_account_new` once the node uses it\nand it holds nothing: `{key, title, hidden, note}`. Its key stays in the\nnode's keystore (the node can't say what is on its way to a key, so no\nsecret is deleted), and it is listed again once the node shows it\nholding anything (what reached it before the node used it isn't seen).\nRefused for any other key, and for one holding anything."
  method request_access(reason: tstr) -> tstr description "Asks to see some of the person's accounts. `reason` (at most 280\ncharacters) is shown in the prompt as the app's own words. If the app\nalready has access the value is `{request: null, state: \"approved\",\naccounts}` and nobody is asked; a request already waiting is returned\nrather than a second one made."
  method request_access_with(reason: tstr, options_json: tstr) -> tstr description "`request_access` with options, a JSON object: `{\"account_hint\": \"Public/<id>\"}` (or\n`Private/<id>`) says which account the sheet ticks first, when the wallet holds it. It\nonly pre-ticks: the person still chooses, and nothing is given without their tick; a hint\nthe wallet doesn't hold is dropped. `\"{}\"` is `request_access(reason)`. An unknown field\nor a malformed hint is refused. get_config `features` lists `request_access_with`."
  method file_sha256(path: tstr) -> tstr description "The SHA-256 (lowercase hex) of the package file at `path`, for the Names app to check a\npackage it ships (the LEZ Bridge) before offering to install it. Only a `.lgx` file of at\nmost 64 MiB; only the Names app may ask. get_config `features` lists `file_sha256`."
  method app_note(key: tstr, value: tstr) -> tstr description "A note the Names app keeps for itself across a reopen of its window (the module keeps\nrunning): stores `value` under `key` (\"\" removes it) and answers the value it had (\"\" when\nnone). In memory only, gone when Basecamp quits; at most 32 keys of 64 characters, values of\n256. Only the Names app may ask. get_config `features` lists `app_note`."
  method faucet_info() -> tstr description "LEZ 0.4 (the bridge test network): what its test-LEZ faucet gives (`bridge_faucetInfo` on\nthe network's endpoint): `{amount, per_account_hours, available, reason}`. Names app only.\nget_config `features` lists `test_lez_faucet`."
  method faucet_claim(account: tstr) -> tstr description "Asks the LEZ 0.4 faucet for test LEZ for `account` (`Public/<id>`, a public account of\nthis wallet), by its public key (a never-used account can only be paid by key): `{ok: true,\ntx, block, amount, account}` once in a block, or `{ok: false, code (already_today |\nfaucet_empty | busy | rate_limited | bad_key), reason, retry}`. Up to 2 minutes. Names app only.\n`{ok: false, code: pending, retry: true, reason}` is asked again: the ask is under way on a\nthread of its own, or (asking nothing yet) the names CLI's version is still being read."
  method granted_accounts() -> tstr description "The accounts this app has been given: `{connected, accounts:\n[{account, account_kind}]}`, where `account` is `Public/<id>` or\n`Private/<id>` and `account_kind` is `public` or `private`. Asks nobody."
  method account_balances() -> tstr description "The LEZ balance of each account this app has been given, `[{account,\naccount_kind, balance, updating, error}]`; `balance` is decimal text\nor null until first read. Balances are read in the background and the\nanswer comes at once with the last one read (`updating` while a newer\none is on the way); ask again for a fresh one. A private account's\nbalance is only here if the person gave this app that account."
  method propose_transfer(asset: tstr, amount: tstr, destination: tstr) -> tstr description "Asks to send `amount` (base units, decimal digits) of `asset` to\n`destination`: a name, or a public account written `Public/<id>`.\n`asset` is `LEZ`, the native token (empty also means LEZ), or a token\nof the wallet's token program, written as its definition's account ID\n(base58); the prompt then shows the token's name and what the Program\nRegistry says about the token program. The person chooses the account\nit comes from. Checked now, so a bad amount, destination or token\nfails here."
  method propose_call(program_id: tstr, accounts_json: tstr, instruction_hex: tstr, summary: tstr) -> tstr description "Asks to run program `program_id` (base58) with the message\n`instruction_hex` (the bytes its transaction carries, on LEZ 0.4\n`borsh(Message::Instruction(..))`; at most 2,048 bytes), signed by the\naccount the person chooses. That account's own actor of the program\ncomes first; `accounts_json` lists the up to 16 other actors it\nreaches, in order: a public account ID (the program's data on it), or\n`{\"account\", \"seed\", \"balance\"}`, where `seed` (64 hex) names one of\nthe program's own accounts (and lets the call create it), `balance:\ntrue` means its LEZ balance rather than the program's data, and\n`\"account\": \"signer\"` (with `balance: true`) is the chosen account's\nLEZ, which only then the program may move.\n`summary` (at most 280 characters) is shown as the app's own words;\nthe prompt also says what the call can do and whether the program's\nsource is verified (from `program_registry`, when installed)."
  method request_status(request_id: tstr) -> tstr description "How this app's request `request_id` stands: `{request, kind, state,\ncreated, expires, decided, account, tx, error, ...}`. `state` is\n`pending` (waiting for the person), `approved` (access given;\n`accounts` lists it), `running` (a transfer under way), `done` (a\ntransfer included in a block, or a call sent: `tx` is its hash),\n`failed` (`error` says why), `rejected`, `expired` (nobody answered\nin 10 minutes) or `cancelled`. `account` is the account the person\nchose. Only the app that made a request can read it."
  method cancel_request(request_id: tstr) -> tstr description "Withdraws this app's own request while it is still pending."
  method drop_access() -> tstr description "Gives up the access this app was given. `{revoked}`."
  method pending_requests() -> tstr description "The requests waiting for the person, oldest first, each with\neverything its prompt shows and `choices`, the accounts it may use:\n`[{account, account_kind, pays, label, granted}]`, all in the names\nCLI's wallet: a payment comes from its main public or private account\n(`pays`), a call is signed by any of its public accounts (those beyond\nthe main one are listed from a read in the background, so they may\nappear a moment later). Names app only."
  method approve_request(request_id: tstr, account: tstr) -> tstr description "Approves request `request_id` with `account`, one of its `choices`\n(for access, one or more separated by commas). Access is given at\nonce; a transfer starts as a names CLI job (`job` in the value); a\ncall is tried, signed and sent by the names CLI (`names module send`)\nand the answer waits for its block (up to two minutes). If the wallet\nis busy the request stays pending and the error says so. Names app only."
  method reject_request(request_id: tstr) -> tstr description "Rejects request `request_id`. Names app only."
  method app_grants() -> tstr description "Which apps have access to which accounts: `[{app, accounts, since}]`.\nNames app only."
  method revoke_app(app: tstr) -> tstr description "Takes back all access `app` was given. Names app only."
  method app_secret(account: tstr, scope: tstr, context_hex: tstr, tag: tstr, first: int, count: int) -> tstr description "Values derived for the calling app from `account` (one of the accounts it was given):\n`SHA256(tag | m_i)` for `i` in `first..first + count` (1 to 64), where `m_i` is a\nmaster value the wallet makes from the account's own key, the app's name as Basecamp\ngives it, `scope` (1-64 printable ASCII) and `context_hex` (up to 256 bytes) and never\ngives out. The same call gives the same values after the wallet is restored from its\nrecovery phrase. The first call for an (app, account, scope) asks the person: the value\nis then `{granted: false, request}`; once they approve, `{granted: true, account, scope,\ntag, first, values: [hex]}`. `tag` is 1-32 printable ASCII."
  method propose_private_call(account: tstr, call_json: tstr, summary: tstr) -> tstr description "Asks the wallet to build, prove and send a privacy-preserving transaction from the\nprivate `account` (one this app was given) across up to 4 programs. `call_json` is\n`{programs, accounts, message, openings, fee_payer, declared, reveal_account}`\n(PROVIDER-SDK.md). The wallet simulates it against the chain first and shows the person\nwhat it really changes; `request_status` gives `check` (`running`, `ready` or\n`failed`; a call the wallet refuses is `ready` with `sheet.refused` true and can't be\napproved) and, once approved, `phase`. `summary` (280 characters) is shown as the app's words."
  method declare_programs(programs_json: tstr, reason: tstr) -> tstr description "Declares the programs this app will ask the wallet to sign calls to someone else pays\nfor (`propose_relayed_call`): a JSON array of 1 to 8 program IDs. The person approves\nit once (`reason`, 280 characters, is shown as the app's words); a relayed call naming\nany other program is refused. A request, as for access."
  method propose_relayed_call(account: tstr, call_json: tstr, summary: tstr) -> tstr description "Asks the wallet to sign, as the public `account` (one this app was given; a never-used\none too), a call whose fee ANOTHER account pays: `call_json` is `{program, message,\naccounts, fee: {payer, gas_limit, tip, max_fee}, privacy}` (PROVIDER-SDK.md, \"Calls\nsomeone else pays for\"). The wallet builds the transaction itself and shows the person\nwhat it built; once approved, `request_status` gives `transaction` (the half-signed\ntransaction, hex borsh) and `hash`. The other account sends it and pays the fee. LEZ 0.4\nonly for now."
  method resign_relayed_call(request_id: tstr) -> tstr description "Signs this app's approved relayed call `request_id` again, without asking the person,\nwhen the fee payer's nonce has moved (a relay that had another transaction in flight)\nand NOTHING else has: the same account and account nonce, program, bytes, actors, payer,\ngas limit, tip and max fee. At most 3 times, within 10 minutes of the approval. Any other\nchange is refused: propose the call again for the person to approve. The value is the\nrequest, with the new `transaction` and `hash`."
  method propose_token_source(token_program: tstr, definitions_json: tstr) -> tstr description "Asks the person to list a token program's definitions in their holdings, with the\nnames, symbols and decimals given: `definitions_json` is `[{definition, name, symbol,\ndecimals, origin}]` (up to 16)."
  method token_sources() -> tstr description "The token sources the person accepted: `[{token_program, definitions, app, since}]`."
  method secret_grants() -> tstr description "The secret grants: `[{app, account, scope, since}]`. Names app only."
  method exit_recipients(app: tstr) -> tstr description "The Ethereum addresses the person approved for `app`'s exit secrets (`RFP022/exit`), by\naccount: `{account: [\"0x…\"]}`. Names app only."
  method approve_exit_recipient(app: tstr, account: tstr, recipient: tstr) -> tstr description "Keeps `recipient` (an Ethereum address) as approved for `app`'s exit secrets from\n`account`: what the Names app does once the person read it back and ticked it on Bridge to\nEthereum. `{approved: true}`. Names app only."
  method revoke_secret(app: tstr, account: tstr, scope: tstr) -> tstr description "Takes back one secret grant. `{revoked}`. Names app only."
  method private_call_control(request_id: tstr, action: tstr) -> tstr description "Pauses, resumes or cancels an approved private call while it is still being planned\nor proven: `action` is `pause`, `resume` or `cancel`. Refused once it is being sent.\nNames app only."
  method token_source_holdings() -> tstr description "What the wallet's accounts hold of every token source's definitions: `[{token_program,\nholdings: [{account, account_kind, definition, name, symbol, decimals, origin,\nbalance}], updating, error}]`. Read in the background. Names app only."
  method cli_token_send_source(token_program: tstr, definition: tstr, amount: tstr, to: tstr, from_private: bool, to_public: bool) -> tstr description "Sends a token of a registered token source, as `cli_token_send` does for the wallet's\nown token program. Names app only."
  method bridge_token_send(bridge: tstr, definition: tstr, amount: tstr, from: tstr, to: tstr, send: bool) -> tstr description "LEZ 0.4 (the bridge test network): moves `amount` (the token's own unit, such as `0.5`) of\nthe wrapped token `definition` of the bridge `bridge` (its program ID) from the wallet's\npublic account `from` (`Public/<id>`) to `to`: a public account (`Public/<id>`) or an LNS\nname's public account. The token program and the decimals come from the bridge's Config,\nwhich must list `definition`. The account the tokens leave pays the fee in test LEZ (the\nbridge's relay pays only for claims and burns). Without `send` it is a CHECK: a wallet job\nthat prices the fee and sends nothing; its ended `job` state has `ready` (or `problem`, in\nplain words) and `fee` `{about, at_most}`. With `send`, the move itself: one block; its\nended `job` state has `tx`, `block` or `problem`. The value is the job, with `plan`\n`{bridge, bridge_label, definition, symbol, decimals, amount, amount_shown, from, to,\nto_name, fee_payer, relay_pays}` for the sheet. Needs a LEZ 0.4 names tool with the\n`bridge` token codec (an older one is said plainly). Names app only. get_config `features`\nlists `bridge_token_send` (`bridge_send.rs`)."
  method remove_token_source(token_program: tstr) -> tstr description "Forgets a token source. `{removed}`. Names app only."
  method nft_programs() -> tstr description "The NFT programs listed for the network in use: `[{program, label, added, registry}]`."
  method nft_program_add(program_id: tstr, label: tstr) -> tstr description "Adds an NFT program (base58) with the person's label; the new list."
  method nft_program_remove(program_id: tstr) -> tstr description "Removes an NFT program; the new list."
  method nft_holdings() -> tstr description "Every account's NFT state under each listed program, the credits waiting for its\nprivate accounts, and the collections held with how many of the accounts hold each:\n`{programs: [{program, label, registry, holdings, pending, collections, read_at}]}`."
  method nft_collection(program_id: tstr, definition: tstr) -> tstr description "A collection's fields: `{definition, name, printable_supply, standard, uri, creators}`."
  method nft_sheet(program_id: tstr, action_json: tstr) -> tstr description "The sheet for an action (`{action: init|send|print|burn|receive, from, to, definition,\nnew, their_keys}`): what it does, what becomes public, the fee and the accounts that can\npay it (private ones for a proven action), any refusal, the program's registry label, and\nthe `digest` an action must name."
  method nft_start(program_id: tstr, action_json: tstr, digest: tstr, fee_payer: tstr) -> tstr description "Starts the action of a sheet (`digest`) as a wallet job; `fee_payer` is one of the sheet's\npayers (required for a proven action; empty for a public one lets its signer pay). Its\nended `job` state has `tx`, `block`, `refusal` and, for an init, `account`."
  method nft_sheet_forget(program_id: tstr, action_json: tstr) -> tstr description "Forgets a sheet's plan, so its next opening reads the chain afresh. `{forgot}`."
  method nft_media(program_id: tstr, definition: tstr, allow: bool) -> tstr description "Allows (or stops) loading a collection's image. `{allowed}`."
  method nft_image(program_id: tstr, definition: tstr, uri: tstr) -> tstr description "A collection's image as pixels, once allowed: `{allowed: false}` or `{width, height, pixels}`."
  method pending_nft_requests() -> tstr description "The waiting NFT requests of other apps (`nft_list`, `nft_transfer`)."
  method approve_nft_request(request_id: tstr, accounts: tstr, digest: tstr, fee_payer: tstr) -> tstr description "Approves an NFT request: a list with the accounts ticked (comma-separated), a transfer\nwith its sheet's `digest` and the private `fee_payer` if it is proven."
  method reject_nft_request(request_id: tstr) -> tstr
  method nft_grants() -> tstr description "The apps that may list NFTs: `[{app, accounts, since, capability, discloses}]`."
  method revoke_nft_access(app: tstr) -> tstr description "Takes every NFT capability from an app (the list, transfers, membership proofs)."
  method revoke_nft_capability(app: tstr, capability: tstr) -> tstr description "Takes one capability from an app: `nft_list`, `nft_transfers` or `membership_proof`."
  method nft_receiving_keys(account: tstr) -> tstr description "A private account's receiving keys for a sender outside the wallet:\n`{account, keys: \"<npk hex>:<vpk hex>\", reveals}` (`reveals`: what sharing them shows)."
  method membership_proof_sheet(request_id: tstr) -> tstr description "The membership-proof sheet for a request (the spec's wording, the private holdings that\ncan prove it, live passes it replaces, the program checks, the owner-decision defaults)."
  method approve_membership_proof(request_id: tstr, holder: tstr) -> tstr description "Approves a proof with the private holding picked; pre-checks, then proves in the\nbackground. `{request, status}`."
  method membership_passes() -> tstr description "The proofs made or under way: `[{request, app, collection, holder, status}]`."
  method request_nft_access(reason: tstr) -> tstr description "Asks to see which NFTs some accounts hold; the person ticks the accounts. Separate from\n`request_access`: neither gives the other."
  method granted_nfts() -> tstr description "The NFTs of the accounts the app was given: `{accounts, nfts: [{program, account,\naccount_kind, definition, token, print_balance, collection}]}`."
  method nft_membership(program_id: tstr, definition: tstr) -> tstr description "Whether those accounts hold an NFT of a collection: `{member, count, accounts}`."
  method propose_nft_transfer(program_id: tstr, from: tstr, destination: tstr, summary: tstr) -> tstr description "Asks to send the NFT an account holds to an LNS name or `Public/<id>`."
  method nft_request_status(request_id: tstr) -> tstr
  method cancel_nft_request(request_id: tstr) -> tstr
  method drop_nft_access() -> tstr
  method request_nft_transfers(reason: tstr) -> tstr description "Asks to be allowed to propose NFT transfers (apart from seeing NFTs)."
  method request_membership_proof(request_json: tstr) -> tstr description "Asks for a membership proof, with no account access: `{program, collection, purpose,\nnonce (64 hex, the app's), ttl (ms, default 1 h)}`. `{request, state}` at once."
  method membership_proof_status(request_id: tstr) -> tstr description "`{request, kind, collection, status: {state: awaiting-approval | checking | proving\n{elapsed_seconds} | sending | waiting-for-block | ready {proof} | failed {code,\nplain_message} | cancelled}}`; the proof is `{gate, slot, not_before, expires_at, tx_hash}`."
  method cancel_membership_proof(request_id: tstr) -> tstr
  method chain_inscribe(from_key: tstr, text: tstr, send: bool) -> tstr description "Inscribes a testimonial (`{\"submission\": \"lp-0022:names-wallet\", \"text\"}`, text\n1-1024 bytes) on the Logos Blockchain from the node key `from_key`, which pays the\nfee. Each key has its own Ed25519 inscription key, made here once and kept 0600,\nand its own channel (`sha256(\"lp-0022:testimonial:\" || signer)`), which the first\ninscription creates and later ones extend. Without `send` the plan `{from, balance,\nsigner, channel, parent, first, submission, text, bytes, msg_id, fee_estimate}`\n(the fee the node asks now, or absent when it couldn't say). A plan moves and\nholds nothing: the node prices it on stand-ins for the key's notes (`chain_fee`),\nso any number of plans, sends and splits can follow at once. With `send` the\ninscription is funded, signed and sent (it cannot be undone) and `hash` and `fee`\n(what it pays) are set; `chain_tx` follows it. A send the node refused after\nfunding it leaves that key's notes held for about 10 final blocks: the same\ninscription sent again uses that funding, anything else from the key meanwhile is\nrefused as held (not short). Names app only. Through logosctl, write\na text or key that is only digits, or `true`/`false`, as `str:2026`:\nlogosctl 0.3.2 sends it as a number or boolean otherwise, and the host refuses the\ncall (\"dispatch_failed: expected string\") before names runs."
  method propose_inscription(text: tstr) -> tstr description "Any app: asks for `text` (a testimonial, 1-1024 bytes) to be inscribed on the\nLogos Blockchain. The person picks which of the node's chain accounts inscribes\nit and pays its fee, and approves it in the Names app. No LEZ access is needed\nfirst: the request names no account. Answers as `request_status` does, kind\n`inscribe`; once done, `tx` is the transaction's hash and `account` the chain key.\nThrough logosctl, a text of only digits or `true`/`false` is written\n`str:<text>` (see `chain_inscribe`)."
  method pending_inscriptions() -> tstr description "The inscription requests waiting for the person, oldest first: `[{id, app, text,\nsays, submission, publisher, choices: [{key, balance, label?, title?}]}]`, the choices the keys\nthe node's wallet holds. When the node can't list them (stopped, say), each request\nis still listed, with `choices` empty and `node` saying why, so it can be rejected.\nA choice carries the `label` the person gave the account (or its keystore `title`),\nand an account hidden while it holds nothing is left out, as in `chain_accounts`.\nThe fee for a choice is `chain_inscribe(key, text, false)`'s `fee_estimate`, which\nholds nothing. `pending_requests` doesn't list these. Names app only."
  method approve_inscription(request_id: tstr, from_key: tstr) -> tstr description "Approves inscription request `request_id` with the node key `from_key`: it is\ninscribed (`chain_inscribe`) and the request is `done` with `tx`. Refused before\nanything is sent (a key the node doesn't hold, too little for the fee), the\nrequest stays pending. Names app only."
}
